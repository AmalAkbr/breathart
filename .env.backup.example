# MongoDB Backup Configuration - Add to your .env file

# ==========================================
# BACKUP CONFIGURATION
# ==========================================

# Enable/disable automatic MongoDB backups
BACKUP_ENABLED=true

# When to run backups (cron format)
# Format: "minute hour day month weekday"
# Examples:
#   0 2 * * *     → Daily at 2:00 AM UTC
#   0 */6 * * *   → Every 6 hours
#   0 0 * * 0     → Weekly on Sunday at midnight
#   0 0 1 * *     → Monthly on 1st at midnight
BACKUP_SCHEDULE=0 2 * * *

# MongoDB database name to backup
BACKUP_DB_NAME=breathart

# Collections to include in backups (comma-separated)
# Default: users,exams,videos,exam-participants
BACKUP_COLLECTIONS=users,exams,videos,exam-participants

# How many days to keep local backups on VPS (older ones deleted automatically)
BACKUP_RETENTION_DAYS=7

# rclone remote name configured for Google Drive
# After running "rclone config", use the remote name here
# (usually "gdrive" unless you named it differently)
RCLONE_GDRIVE_REMOTE=gdrive

# ==========================================
# HOW TO SET UP:
# ==========================================
# 1. On your VPS, run:
#    curl https://rclone.org/install.sh | sudo bash
#    rclone config
#
# 2. Create a remote named "gdrive" (or your preferred name)
#    - When prompted for storage type, select "Google Drive"
#    - Use browser to authenticate
#    - rclone saves credentials to ~/.config/rclone/rclone.conf
#
# 3. Set RCLONE_GDRIVE_REMOTE to your remote name (default: "gdrive")
#
# 4. Set BACKUP_ENABLED=true
#
# 5. Restart your backend
#
# 6. Check logs for "✅ Backup scheduler started"
#
# 7. Verify files in Google Drive: rclone ls gdrive:/mongo-backups/

# ==========================================
# VERIFY IT'S WORKING:
# ==========================================
# In VPS terminal:
#   rclone ls gdrive:/mongo-backups/
#
# Or POST to admin endpoint (if implemented):
#   POST /api/admin/backup/trigger
#   Authorization: Bearer YOUR_ADMIN_TOKEN
#
# View combined size:
#   rclone du gdrive:/mongo-backups/

# ==========================================
# TROUBLESHOOTING:
# ==========================================
# If "command not found: mongoexport":
#   Install: sudo apt-get install mongodb-org-tools
#
# If "command not found: rclone":
#   Install: curl https://rclone.org/install.sh | sudo bash
#
# If backups not uploading:
#   Check: rclone listremotes
#   Test:  rclone ls gdrive:/
#
# If auth expired:
#   Re-run: rclone config
#   Select: e (edit remote)
#   Follow browser auth again
